<h2 class="mb-3 fw-bold">落とし物一覧</h2>

<!-- 検索・絞り込みフォーム（相方の機能をBootstrapで装飾） -->
<div class="card mb-4 shadow-sm border-0 bg-light">
  <div class="card-body">
    <%= form_with url: root_path, method: :get, data: { turbo: false }, class: "row g-3 align-items-end" do %>
      <div class="col-md-3">
        <label for="sort" class="form-label fw-bold">並び替え</label>
        <select id="sort" name="sort" class="form-select">
          <option value="date" <%= "selected" if params[:sort] == "date" %>>日付</option>
          <option value="place" <%= "selected" if params[:sort] == "place" %>>場所</option>
          <option value="category" <%= "selected" if params[:sort] == "category" %>>種類</option>
        </select>
      </div>
      <div class="col-md-3">
        <label for="found_at" class="form-label fw-bold">日時で絞り込み</label>
        <input id="found_at" name="found_at" type="date" value="<%= params[:found_at] %>" class="form-control">
      </div>
      <div class="col-md-3">
        <label for="found_place" class="form-label fw-bold">場所で絞り込み</label>
        <input id="found_place" name="found_place" type="text" value="<%= params[:found_place] %>" class="form-control">
      </div>
      <div class="col-md-2">
        <label for="category" class="form-label fw-bold">種類で絞り込み</label>
        <input id="category" name="category" type="text" value="<%= params[:category] %>" class="form-control">
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-primary w-100">検索</button>
      </div>
    <% end %>
  </div>
</div>

<!-- カード型デザインのグリッド -->
<div class="row row-cols-1 row-cols-md-3 g-4">
  <% @lost_items.each do |lost_item| %>
    <div class="col">
      <div class="card h-100 shadow-sm border-0 bg-light">
        <!-- 写真部分 -->
        <% if lost_item.photo.attached? %>
          <%= image_tag lost_item.photo, class: "card-img-top rounded-top", style: "height: 200px; object-fit: cover;" %>
        <% else %>
          <div class="card-img-top bg-secondary text-white d-flex align-items-center justify-content-center rounded-top" style="height: 200px;">
            <span class="fs-5">NO IMAGE</span>
          </div>
        <% end %>
        
        <!-- テキスト部分 -->
        <div class="card-body">
          <h5 class="card-title fw-bold text-dark"><%= lost_item.name %></h5>
          <p class="card-text text-muted mb-2">
            <strong>場所:</strong> <%= lost_item.found_place %><br>
            <% if lost_item.found_at %>
              <strong>日時:</strong> <%= l(lost_item.found_at, format: :short) %><br>
            <% end %>
            <% if lost_item.category.present? %>
              <strong>種類:</strong> <%= lost_item.category %><br>
            <% end %>
            <% if lost_item.feature.present? %>
              <strong>特徴:</strong> <%= lost_item.feature %><br>
            <% end %>
          </p>
          <!-- ステータスバッジ -->
          <span class="badge <%= lost_item.status == '受け取り済み' ? 'bg-success' : 'bg-warning text-dark' %> px-2 py-1">
            <%= lost_item.status %>
          </span>
        </div>
      </div>
    </div>
  <% end %>
</div>