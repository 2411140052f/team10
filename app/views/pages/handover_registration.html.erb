<h1>受け渡し登録</h1>

<nav>
  <%= link_to "ホーム", root_path %> |
  <%= link_to "捜索願一覧", missing_reports_path %> |
  <%= link_to "職員ログイン", staff_login_path %> |
  <%= link_to "忘れ物登録", lost_item_registration_path %>
</nav>
<%= button_to "ログアウト", logout_path, method: :delete %>

<% if flash[:notice] %>
  <p role="status"><%= flash[:notice] %></p>
<% end %>
<% if flash[:alert] %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>

<h2>落とし物ステータス変更</h2>
<div>
  <% @lost_items.each do |lost_item| %>
    <article>
      <p>落とし物ID: <%= lost_item.id %></p>
      <p>物の名前: <%= lost_item.name %></p>
      <p>状態: <%= lost_item.status %></p>
      <% if lost_item.status != "受け取り済み" %>
        <%= button_to "受け取り済みに変更",
              lost_item_status_path(lost_item),
              method: :patch %>
      <% end %>
    </article>
  <% end %>
</div>

<h2>捜索願削除</h2>
<%= form_with url: missing_reports_path, method: :delete, data: { turbo: false } do %>
  <div>
    <label for="missing_report_code">捜索願ID</label>
    <input id="missing_report_code" name="code" type="number" min="1" required>
  </div>
  <button type="submit">削除</button>
<% end %>

<h2>捜索願削除申請一覧</h2>
<div>
  <% @deletion_requests.each do |deletion_request| %>
    <article>
      <p>捜索願ID: <%= deletion_request.missing_report.code %></p>
      <p>申請者学籍番号: <%= deletion_request.student_number %></p>
      <p>申請者氏名: <%= deletion_request.name %></p>
      <p>申請日時: <%= l(deletion_request.created_at, format: :long) %></p>
    </article>
  <% end %>
</div>
